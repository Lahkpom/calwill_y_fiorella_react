# URL base de la API REST del backend Spring Boot.
# Desarrollo local: usar la dirección y el puerto donde esté ejecutándose el backend.
VITE_API_URL=http://localhost:8080/api

# Producción: configurar esta variable en Vercel con la URL pública del servicio
# de backend desplegado en Render. Reemplazar el ejemplo por la URL real.
# VITE_API_URL=https://tu-backend.onrender.com/api

# Las variables VITE_* se incluyen en el frontend durante el build.
# No colocar claves secretas aquí. La integración con Supabase Storage debe
# realizarse usando la URL presigned que entrega el backend, sin credenciales
# de Supabase en el navegador.
